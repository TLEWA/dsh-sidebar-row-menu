{
  "name": "dsh-sidebar-row-menu",
  "version": "1.1.0",
  "type": "module",
  "description": "DSH plugin: official-style right-click menus for workspace rows; session rows open the native slot-composed menu (built-in and third-party actions included), with VS Code / File Explorer / copy-link entries contributed back to that slot.",
  "keywords": [
    "deepseek",
    "dsh",
    "deepseek-harness",
    "plugin",
    "sidebar",
    "context-menu",
    "workspace",
    "session",
    "vscode"
  ],
  "author": "SideBar contributors",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/host.test.mjs test/client.test.mjs",
    "test:local": "node --test --test-isolation=none test/host.test.mjs test/client.test.mjs"
  }
}
