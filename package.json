{
  "name": "dsh-sidebar-row-menu",
  "version": "1.4.1",
  "type": "module",
  "description": "DSH sidebar right-click menus: a self-composed menu for workspace rows, and the native slot menu opened at the pointer for session rows, with open-with and archived-session cleanup.",
  "keywords": [
    "deepseek",
    "dsh",
    "deepseek-harness",
    "plugin",
    "dsh-plugin",
    "sidebar",
    "context-menu",
    "workspace",
    "session",
    "vscode"
  ],
  "author": "SideBar contributors",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "scripts/install.ps1",
    "scripts/marketplace-preflight.mjs",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE.md",
    "NOTICE.en.md",
    "AI_USAGE.md",
    "AI_USAGE.en.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/host.test.mjs test/client.test.mjs",
    "test:local": "node --test --test-isolation=none test/host.test.mjs test/client.test.mjs",
    "check": "node --check lib/index.js && node --check lib/client.js && node --check lib/host/paths.js && node --check lib/host/security.js && node --check lib/host/launch.js && node --check lib/host/route.js && node --check lib/host/session-delete.js",
    "build": "npm pack",
    "marketplace:check": "node scripts/marketplace-preflight.mjs",
    "prepack": "npm run check",
    "prepublishOnly": "npm run check"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TLEWA/dsh-sidebar-row-menu.git"
  },
  "homepage": "https://github.com/TLEWA/dsh-sidebar-row-menu#readme",
  "bugs": {
    "url": "https://github.com/TLEWA/dsh-sidebar-row-menu/issues"
  }
}
