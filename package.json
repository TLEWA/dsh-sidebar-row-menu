{
  "name": "dsh-sidebar-row-menu",
  "version": "1.13.0",
  "type": "module",
  "description": "Adds open-with and cleanup entries to the DSH sidebar context menus (interleaved on 0.2.2+, self-drawn workspace menu on 0.2.1), plus a conversation-body right-click menu that mirrors the session header toolbar with in-menu open-with and more-actions submenus.",
  "keywords": [
    "deepseek",
    "dsh",
    "deepseek-harness",
    "plugin",
    "dsh-plugin",
    "sidebar",
    "context-menu",
    "workspace",
    "session",
    "vscode"
  ],
  "author": "SideBar contributors",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "scripts/install.ps1",
    "scripts/marketplace-preflight.mjs",
    "cordis.patch.yml",
    "AGENTS.md",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "CHANGELOG.en.md",
    "LICENSE",
    "NOTICE.md",
    "NOTICE.en.md",
    "AI_USAGE.md",
    "AI_USAGE.en.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    },
    "manifestVersion": 1
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.5 <0.3.0-0"
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "test": "node --test test/host.test.mjs test/manifest.test.mjs test/client.test.mjs",
    "pretest": "npm run build:client",
    "test:local": "node --test --test-isolation=none test/host.test.mjs test/manifest.test.mjs test/client.test.mjs",
    "check": "npm run check:syntax && npm run check:client",
    "check:syntax": "node --check lib/index.js && node --check lib/client.js && node --check lib/host/paths.js && node --check lib/host/security.js && node --check lib/host/launch.js && node --check lib/host/route.js && node --check lib/host/permission-defaults.js && node --check lib/host/session-delete.js && node --check lib/host/workspace-delete.js",
    "check:client": "node scripts/build-client.mjs --check",
    "build": "npm pack",
    "marketplace:check": "node scripts/marketplace-preflight.mjs",
    "prepack": "npm run build:client && npm run check",
    "prepublishOnly": "npx --yes --package=github:TLEWA/dsh-plugin-ci#v1 dsh-ci-gate --prepublish"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TLEWA/dsh-sidebar-row-menu.git"
  },
  "homepage": "https://github.com/TLEWA/dsh-sidebar-row-menu#readme",
  "bugs": {
    "url": "https://github.com/TLEWA/dsh-sidebar-row-menu/issues"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
